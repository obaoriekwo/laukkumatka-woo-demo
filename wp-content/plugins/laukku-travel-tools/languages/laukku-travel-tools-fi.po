#. Plugin Name of the plugin
#: laukku-travel-tools.php
msgid "Laukku Travel Tools"
msgstr ""

#. Description of the plugin
#: laukku-travel-tools.php
msgid ""
"Luggage-specific features for a WooCommerce bag & luggage store: cabin-size "
"checker per airline, \"will it fit?\" product finder, free-shipping progress"
" bar, richer product structured data and a catalogue quality audit (admin "
"page + WP-CLI)."
msgstr ""

#. Author of the plugin
#: laukku-travel-tools.php
msgid "Oba Oriekwo"
msgstr ""

